---
// Day / Night service switcher
---

<button type="button" class="theme-toggle" id="theme-toggle" aria-label="Toggle theme">
  <span class="theme-label" id="theme-label">Day</span>
</button>

<script>
  function initTheme() {
    const toggle = document.getElementById('theme-toggle');
    const label = document.getElementById('theme-label');
    const root = document.documentElement;

    const saved = localStorage.getItem('pinakes-theme') || 'day';
    root.setAttribute('data-theme', saved);
    if (label) label.textContent = saved === 'night' ? 'Night' : 'Day';

    toggle?.addEventListener('click', () => {
      const current = root.getAttribute('data-theme') || 'day';
      const next = current === 'day' ? 'night' : 'day';
      root.setAttribute('data-theme', next);
      localStorage.setItem('pinakes-theme', next);
      if (label) label.textContent = next === 'night' ? 'Night' : 'Day';
    });
  }

  initTheme();
  document.addEventListener('astro:after-swap', initTheme);
</script>

<style>
  .theme-toggle {
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.25rem 0.75rem;
    font-size: 0.85rem;
    font-family: var(--font-sans);
    color: var(--color-text-muted);
    cursor: pointer;
  }
  .theme-toggle:hover {
    color: var(--color-text);
    border-color: var(--color-text-muted);
  }
</style>
