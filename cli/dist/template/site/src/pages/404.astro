---
import Base from '../layouts/Base.astro';
---

<Base title="Page Not Found">
  <div class="not-found">
    <h1>404</h1>
    <p>This chapter or room could not be found.</p>
    <a href="/" class="home-link">&larr; Return to Menu</a>
  </div>
</Base>

<style>
  .not-found {
    text-align: center;
    padding: 4rem 0;
  }
  .not-found h1 {
    font-size: 4rem;
    margin: 0;
    color: var(--color-accent);
  }
  .home-link {
    display: inline-block;
    margin-top: 1.5rem;
    font-family: var(--font-sans);
  }
</style>
